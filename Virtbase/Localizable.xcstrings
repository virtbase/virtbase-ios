    "Alle lokalen Daten werden entfernt, und sie werden sofort abgemeldet. Dies lässt sich nicht rückgangig machen." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "All local data will be removed and you will be signed out immediately. This cannot be undone." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所有本地数据将被删除，您将立即退出登录。此操作无法撤销。" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Tutti i dati locali verranno rimossi e verrai disconnesso immediatamente. Questa operazione non può essere annullata." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Wszystkie lokalne dane zostaną usunięte i zostaniesz natychmiast wylogowany. Tej operacji nie można cofnąć." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Toutes les données locales seront supprimées et vous serez déconnecté immédiatement. Cette action est irréversible." } }
