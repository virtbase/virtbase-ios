      }
    },
    "Virtbase Schlüssel" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Virtbase Key" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Virtbase 密钥" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Chiave Virtbase" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Klucz Virtbase" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Clé Virtbase" } }
      }
    },
    "Virtbase verwendet sogenannte API-Schlüssel, um Entwicklern eine einfache und zuverlässige Schnittstelle für Erweiterungen, Integrationen und automatisierte Systeme bereitzustellen. Die Virtbase App greift auf diese Schlüssel zu, um entsprechende Funktionen zu ermöglichen." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Virtbase uses API keys to provide developers with a simple and reliable interface for extensions, integrations, and automated systems. The Virtbase app accesses these keys to enable the corresponding features." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Virtbase 使用 API 密钥为开发者提供简单可靠的扩展、集成和自动化系统接口。Virtbase 应用访问这些密钥以启用相应功能。" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Virtbase utilizza le chiavi API per fornire agli sviluppatori un'interfaccia semplice e affidabile per estensioni, integrazioni e sistemi automatizzati. L'app Virtbase accede a queste chiavi per abilitare le funzionalità corrispondenti." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Virtbase używa kluczy API, aby zapewnić deweloperom prosty i niezawodny interfejs dla rozszerzeń, integracji i zautomatyzowanych systemów. Aplikacja Virtbase uzyskuje dostęp do tych kluczy, aby umożliwić odpowiednie funkcje." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Virtbase utilise des clés API pour fournir aux développeurs une interface simple et fiable pour les extensions, intégrations et systèmes automatisés. L'application Virtbase accède à ces clés pour activer les fonctionnalités correspondantes." } }
      }
    },
