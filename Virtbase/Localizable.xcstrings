    },
    "Deine Server konnten nicht geladen werden. Überprüfe deine Internetverbindung, oder ob du angemeldet bist." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your servers could not be loaded. Check your internet connection or whether you are signed in." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法加载您的服务器。请检查您的网络连接或是否已登录。" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Impossibile caricare i tuoi server. Controlla la connessione a Internet o se sei connesso." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Nie udało się załadować serwerów. Sprawdź połączenie z internetem lub czy jesteś zalogowany." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vos serveurs n'ont pas pu être chargés. Vérifiez votre connexion internet ou si vous êtes connecté." } }
      }
    },
    "Details" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Details" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "详情" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Dettagli" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Szczegóły" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Détails" } }
      }
    },
    "Die Anfrage an den Server ist fehlgeschlagen. Überprüfe ob du mit dem Internet verbunden bist oder dein Schlüssel alle benötigten Berechtigungen hat." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The request to the server failed. Check whether you are connected to the internet or your key has all required permissions." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务器请求失败。请检查您是否已连接到互联网，或您的密钥是否具有所有必要权限。" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La richiesta al server è fallita. Controlla se sei connesso a Internet o se la tua chiave ha tutte le autorizzazioni necessarie." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Żądanie do serwera nie powiodło się. Sprawdź, czy jesteś połączony z internetem lub czy Twój klucz ma wszystkie wymagane uprawnienia." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La requête vers le serveur a échoué. Vérifiez si vous êtes connecté à internet ou si votre clé dispose de toutes les autorisations requises." } }
      }
    },
    "Die Keychain konnte nicht geleert werden. Bitte erneut versuchen oder die App neu installieren." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Keychain could not be cleared. Please try again or reinstall the app." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法清除钥匙串。请重试或重新安装应用。" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Impossibile svuotare il Keychain. Riprova o reinstalla l'app." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Nie udało się wyczyścić pęku kluczy. Spróbuj ponownie lub zainstaluj aplikację ponownie." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le trousseau n'a pas pu être vidé. Veuillez réessayer ou réinstaller l'application." } }
      }
    },
    "Diese Berechtigungen sind notwendig, damit die Virtbase App ordnungsgemäß funktionieren kann. Das Entfernen oder Einschränken dieser Berechtigungen kann zu Fehlfunktionen der App führen und unauthentifizierte Anfragen verursachen." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "These permissions are necessary for the Virtbase app to function properly. Removing or restricting these permissions may cause the app to malfunction and result in unauthenticated requests." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这些权限对于 Virtbase 应用正常运行是必要的。删除或限制这些权限可能导致应用出现故障并产生未经授权的请求。" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Queste autorizzazioni sono necessarie per il corretto funzionamento dell'app Virtbase. La rimozione o la limitazione di queste autorizzazioni può causare malfunzionamenti dell'app e richieste non autenticate." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Te uprawnienia są niezbędne do prawidłowego działania aplikacji Virtbase. Usunięcie lub ograniczenie tych uprawnień może spowodować nieprawidłowe działanie aplikacji i nieautoryzowane żądania." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ces autorisations sont nécessaires au bon fonctionnement de l'application Virtbase. La suppression ou la restriction de ces autorisations peut entraîner des dysfonctionnements de l'application et des requêtes non authentifiées." } }
      }
    },
    "Discord" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Discord" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Discord" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Discord" } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Discord" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Discord" } }
      }
    },
    "Du hast noch keine Server in deinem Account hinzugefügt. Öffne Virtbase, um deinen ersten Server einzurichten." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You haven't added any servers to your account yet. Open Virtbase to set up your first server." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "您还没有向账户添加任何服务器。打开 Virtbase 来设置您的第一台服务器。" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Non hai ancora aggiunto alcun server al tuo account. Apri Virtbase per configurare il tuo primo server." } },
        "pl" : { "stringUnit" : { "state" : "translated", "value" : "Nie dodałeś jeszcze żadnych serwerów do swojego konta. Otwórz Virtbase, aby skonfigurować pierwszy serwer." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vous n'avez encore ajouté aucun serveur à votre compte. Ouvrez Virtbase pour configurer votre premier serveur." } }
      }
    },
